<Window x:Class="PresenterShield.Views.BorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BorderWindow" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ShowInTaskbar="False"
        Topmost="True"
        IsHitTestVisible="False"
        Focusable="False">
    
    <Grid>
        <Border BorderBrush="#FF0000" BorderThickness="1" CornerRadius="0">
            <Border.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
        </Border>
    </Grid>
</Window>
