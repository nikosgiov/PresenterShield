<Window x:Class="PresenterShield.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:PresenterShield.ViewModels"
        xmlns:helpers="clr-namespace:PresenterShield.Helpers"
        Title="PresenterShield" Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FAF9F8"
        Icon="pack://application:,,,/Assets/presenterShield.png">
    
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BoolToStringConverter x:Key="BoolToStringConverter" />
        
        <!-- Modern Windows 11 ListBoxItem Style (Removes harsh blue highlight) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Padding="4,2" Margin="2,1" CornerRadius="4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F3F3" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EAE8E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#005FB8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0053A0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00478A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Destructive Button Style -->
        <Style x:Key="DestructiveButton" TargetType="Button">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B12417" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9F2015" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select Windows to Keep Private" FontWeight="SemiBold" FontSize="16" Foreground="#202020" Margin="0,0,0,12" />

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E5E5E5" BorderThickness="1" Margin="0,0,0,20">
            <ListBox ItemsSource="{Binding Windows}" Margin="4" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- CheckBox layout aligned center -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsPrivate}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="12,0,10,0" Foreground="#333333" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            
                            <Button Grid.Column="2" Content="👁️" Command="{Binding DataContext.BringToFrontCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,8,0" Background="Transparent" BorderThickness="0" ToolTip="Bring window to front" FontSize="14" Cursor="Hand" />
                            
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Slider Minimum="0" Maximum="255" Value="{Binding Opacity}" Width="80" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Opacity}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666666" FontSize="12" Width="25"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Start Shield Session" Style="{StaticResource PrimaryButton}" 
                    Command="{Binding StartSessionCommand}" 
                    Visibility="{Binding IsSessionActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            
            <Button Grid.Column="0" Content="Stop Shield Session" Style="{StaticResource DestructiveButton}" 
                    Command="{Binding StopSessionCommand}" 
                    Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Button Grid.Column="2" 
                    Content="{Binding IsMirroringActive, Converter={StaticResource BoolToStringConverter}, FallbackValue='Start Secure Mirroring'}" 
                    Style="{StaticResource PrimaryButton}" 
                    Command="{Binding ToggleMirroringCommand}" />
        </Grid>
    </Grid>
</Window>
